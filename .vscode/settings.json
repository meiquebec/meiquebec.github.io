{
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.env.windows": {
        "PATH": "${workspaceFolder};${workspaceFolder}\\node_modules\\.bin;${env:PATH}"
    },
    "terminal.integrated.env.osx": {
        "PATH": "${workspaceFolder}:${workspaceFolder}/node_modules/.bin:${env:PATH}"
    },
    "terminal.integrated.env.linux": {
        "PATH": "${workspaceFolder}:${workspaceFolder}/node_modules/.bin:${env:PATH}"
    },
    "editor.rulers": [100],
    "intelephense.environment.includePaths": [
        "node_modules/@kirigami/php-prepros/src/libraries"
    ],
    "intelephense.files.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "!**/node_modules/@kirigami/php-prepros/**"
    ],
    "yaml.schemas": {
        "https://cdn.jsdelivr.net/npm/@kirigami/kirigami/kirigami.schema.json": "kirigami.yaml",
        "./assets/schemas/articles.schema.json": "articles.yaml",
        "./assets/schemas/equipe.schema.json": "equipe.yaml",
        "./assets/schemas/comites.schema.json": "comites.yaml"
    },
    "folder-path-color.folders": [
        { "path": "src", "color": "cyan" },
        { "path": "assets", "color": "magenta" },
        { "path": "scripts", "color": "yellow" }
    ]
}
